# Local development defaults only. Copy to .env (git-ignored) and change for anything shared.
# Never reuse these values outside a local machine.
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=ledgercore_admin
POSTGRES_SUPERUSER_PASSWORD=local-dev-only-admin
LEDGER_DB_PASSWORD=local-dev-only-ledger
LEDGER_RUNTIME_DB_PASSWORD=local-dev-only-ledger-runtime
POLICY_DB_PASSWORD=local-dev-only-policy
POLICY_RUNTIME_DB_PASSWORD=local-dev-only-policy-runtime
LEDGER_PORT=8080
POLICY_PORT=8081
# Shared service credentials (ADR-013), at least 32 characters, and different from each other.
POLICY_DECISION_API_TOKEN=local-dev-only-decision-token-change-me-0001
# Leave empty to disable the policy management API.
POLICY_ADMIN_API_TOKEN=local-dev-only-admin-token-change-me-00000002
